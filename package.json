{
  "name": "ghostpart",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/finalize-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "prettier --write src tests scripts/*.mjs README.md ROADMAP.md CONTRIBUTING.md PRETEST.md",
    "format:check": "prettier --check src tests scripts/*.mjs README.md ROADMAP.md CONTRIBUTING.md PRETEST.md",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-aruco2": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
